{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu
# Pacman package data: {{ printf "%q %q %q %q %q" .packages.common .packages.linux.pacman (index .packages.linux.roles .role "pacman") .features.t2 .packages.linux.t2.pacman | sha256sum }}
if ! command -v pacman >/dev/null 2>&1; then
    echo "Linux package installation requires pacman (Arch/CachyOS)." >&2
    exit 1
fi
xargs -r sudo pacman -S --needed --noconfirm < "{{ .chezmoi.homeDir }}/.config/pacman/packages.txt"
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
