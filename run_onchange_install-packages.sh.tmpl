#!/bin/bash
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}
brew bundle --file="{{ .chezmoi.homeDir }}/.config/homebrew/Brewfile"

# --- agent-browser (via fnm-managed node, not brew) ---
FNM_NPM="{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npm"
if ! command -v agent-browser &> /dev/null; then
    echo "Installing agent-browser..."
    "$FNM_NPM" install -g agent-browser
fi

{{- if eq .role "work" }}
# --- Dagger ---
if ! command -v dagger &> /dev/null; then
    echo "Installing Dagger..."
    curl -fsSL https://dl.dagger.io/dagger/install.sh | DAGGER_VERSION=0.21.7 BIN_DIR=/usr/local/bin sh
fi
{{- end }}

# --- Pi ---
if ! command -v pi &> /dev/null; then
    echo "Installing Pi..."
    curl -fsSL https://pi.dev/install.sh | sh
fi
