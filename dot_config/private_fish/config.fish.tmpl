{{ if eq .chezmoi.osRelease.id "cachyos" }}
source /usr/share/cachyos-fish-config/cachyos-config.fish
{{ end }}

{{ if eq .role "personal" }}
# Match the Proton Pass SSH agent socket managed by the platform service.
set -gx SSH_AUTH_SOCK "$HOME/.ssh/proton-pass-agent.sock"
{{ end }}

status is-login; and begin
    # Login shell initialisation
end

status is-interactive; and begin
    fish_add_path "$HOME/.local/bin"
{{ if eq .chezmoi.os "darwin" }}
    set -x HOMEBREW_NO_ANALYTICS 1

    if test -d "$HOME/.lmstudio/bin"
        fish_add_path "$HOME/.lmstudio/bin"
    end

    if command -q brew
        brew shellenv | source
    end
{{ end }}

{{ if eq .role "work" }}
    set -x AWS_PROFILE bedrock
    set -x INFRA_SKIP_VERSION_CHECK true
    set -x KITCHEN_LOCAL_YAML .kitchen.gce.yml
    set -x FASTLY_CHEF_USERNAME gunnarsundberg
    set -x GOOGLE_SSH_USERNAME gunnar.sundberg
{{ end }}
end
