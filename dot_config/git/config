[commit]
	gpgSign = true

[gpg]
	format = "ssh"

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "current"

[tag]
	gpgSign = true

[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"

[user]
	email = "gunnarsundberg@pm.me"
	name = "Gunnar Sundberg"
	signingKey = ""
