{
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 16384
  },
  "defaultModel": "global.anthropic.claude-sonnet-5",
  "defaultProvider": "amazon-bedrock",
  "enableInstallTelemetry": false,
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "lastChangelogVersion": "0.82.1",
  "theme": "dark",
  "npmCommand": ["{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/npm"],
  "packages": [
		{{- if eq .role "work" }}
    "git:github.com/fastly/agent-skills-internal",
		{{- end }}
    "git:github.com/obra/superpowers",
    "npm:pi-subagents",
    "npm:pi-intercom",
		"npm:pi-claude-bridge"
  ]
}
